#!/usr/bin/env bash
# Run the test suite in Docker.  Arguments are passed to pytest.
# Set LAMBDAMLM_WRITE_GOLDEN=1 to record golden files (see tests/golden.py).
set -euo pipefail
cd "$(dirname "$0")/.."
docker build --quiet --file tests/Dockerfile --tag lambdamlm-test . >/dev/null
mount="$PWD:/src:ro"
if [ "${LAMBDAMLM_WRITE_GOLDEN:-}" = 1 ]; then
    mount="$PWD:/src"
fi
docker run --rm \
    --user "$(id -u):$(id -g)" \
    --env LAMBDAMLM_WRITE_GOLDEN="${LAMBDAMLM_WRITE_GOLDEN:-}" \
    --volume "$mount" \
    --workdir /src \
    lambdamlm-test \
    python -m pytest -p no:cacheprovider "$@"
