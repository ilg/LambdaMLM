#!/usr/bin/env python3
"""Adopt an existing deployment's S3 bucket into a new LambdaMLM stack.

    scripts/import-bucket [--yes]

Run this once, before the first scripts/deploy, when moving a deployment made
with the old fabfile to the SAM stack.  It creates the stack (named by
stack_name in lambda/config.py) containing only the bucket named by s3_bucket,
without changing the bucket or anything in it.  scripts/deploy then adds the
rest of the stack and applies the template's bucket settings.

CloudFormation can't create other resources in the same operation as an
import, which is why this is a separate step.  New deployments don't need it:
scripts/deploy creates the bucket.
"""

import importlib.util
import json
import os
import subprocess
import sys
from importlib.machinery import SourceFileLoader


def _load_deploy():
    """Import scripts/deploy, which has no .py extension, for its helpers."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'deploy')
    loader = SourceFileLoader('deploy', path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader('deploy', loader))
    loader.exec_module(module)
    return module


deploy = _load_deploy()

CHANGE_SET_NAME = 'import-bucket'


def import_template(bucket):
    """A template holding only the bucket, as the full template declares it."""
    return json.dumps({
        'AWSTemplateFormatVersion': '2010-09-09',
        'Description': 'LambdaMLM: importing the existing bucket.  scripts/deploy adds the rest.',
        'Resources': {
            'MailBucket': {
                'Type': 'AWS::S3::Bucket',
                'DeletionPolicy': 'Retain',
                'UpdateReplacePolicy': 'Retain',
                'Properties': {'BucketName': bucket},
            },
        },
    }, indent=2)


def aws(region, *args, capture=False):
    command = ('aws', '--region', region) + args
    if capture:
        return subprocess.run(command, capture_output=True, text=True)
    deploy.run(*command)


def main(args):
    try:
        config = deploy.load_config(deploy.CONFIG)
        deploy.check_config(config, deploy.load_config(deploy.CONFIG_EXAMPLE))
    except deploy.ConfigError as e:
        sys.exit(str(e))
    region = config['lambda_region']
    stack = deploy.stack_name(config)
    bucket = config['s3_bucket']

    if aws(region, 'cloudformation', 'describe-stacks', '--stack-name', stack, capture=True).returncode == 0:
        sys.exit('Stack {} already exists, so there is nothing to import.'.format(stack))
    if aws(region, 's3api', 'head-bucket', '--bucket', bucket, capture=True).returncode != 0:
        sys.exit("Bucket {} doesn't exist (or isn't yours), so there is nothing to import.  "
                 'For a new deployment, just run scripts/deploy.'.format(bucket))

    template_path = os.path.join(deploy.ROOT, 'build', 'import-template.json')
    os.makedirs(os.path.dirname(template_path), exist_ok=True)
    with open(template_path, 'w') as f:
        f.write(import_template(bucket))

    resources = [{
        'ResourceType': 'AWS::S3::Bucket',
        'LogicalResourceId': 'MailBucket',
        'ResourceIdentifier': {'BucketName': bucket},
    }]
    aws(region, 'cloudformation', 'create-change-set',
        '--stack-name', stack,
        '--change-set-name', CHANGE_SET_NAME,
        '--change-set-type', 'IMPORT',
        '--resources-to-import', json.dumps(resources),
        '--template-body', 'file://' + template_path)
    aws(region, 'cloudformation', 'wait', 'change-set-create-complete',
        '--stack-name', stack, '--change-set-name', CHANGE_SET_NAME)
    aws(region, 'cloudformation', 'describe-change-set',
        '--stack-name', stack, '--change-set-name', CHANGE_SET_NAME,
        '--query', 'Changes[].ResourceChange.[Action,LogicalResourceId,PhysicalResourceId]',
        '--output', 'table')

    if '--yes' not in args:
        answer = input('Import bucket {} into new stack {} in {}? [y/N] '.format(bucket, stack, region))
        if answer.strip().lower() not in ('y', 'yes'):
            aws(region, 'cloudformation', 'delete-stack', '--stack-name', stack)
            sys.exit('Cancelled; the pending stack was removed and the bucket is untouched.')

    aws(region, 'cloudformation', 'execute-change-set',
        '--stack-name', stack, '--change-set-name', CHANGE_SET_NAME)
    aws(region, 'cloudformation', 'wait', 'stack-import-complete', '--stack-name', stack)
    print('Imported {} into stack {}.  Next, run scripts/deploy to add the rest of the stack.'
          .format(bucket, stack))


if __name__ == '__main__':
    main(sys.argv[1:])
